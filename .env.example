# MUXCORE_MODULE_ID=serialization-safe
# SERIALIZATION_GRPC_ADDR=127.0.0.1:9635
# SERIALIZATION_MAX_PAYLOAD_BYTES=4194304
# MVP_ENABLE_SERIALIZATION_SAFE=1
